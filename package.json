{
  "name": "mcp-nexus",
  "version": "0.7.0",
  "description": "Open-source intelligent routing & discovery layer for MCP tools. One endpoint, hundreds of tools — dynamic capability discovery, policy-aware execution, LLM-optional hybrid router.",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://github.com/dsk-dev-ai/mcp-nexus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsk-dev-ai/mcp-nexus.git"
  },
  "bugs": {
    "url": "https://github.com/dsk-dev-ai/mcp-nexus/issues"
  },
  "bin": {
    "mcp-nexus": "src/index.ts"
  },
  "files": [
    "src",
    "docs",
    "tools"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/index.ts",
    "start:stdio": "node src/index.ts start",
    "dev": "node --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:coverage": "node --test --experimental-test-coverage tests/"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agents",
    "llm",
    "router",
    "agent-tools",
    "tool-discovery"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  }
}
