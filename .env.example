# MCP Nexus — environment configuration
# Copy this file to .env and fill in what you need. Never commit .env.

# HTTP/port used by the dashboard/HTTP integration (future)
MCP_NEXUS_PORT=3000

# Routing provider chain, comma separated, tried left to right.
# Providers: heuristic, semantic, llm
# LLM is OPTIONAL. V1 works with heuristic alone. npm run start keeps working
# with no API keys configured.
ROUTER_PROVIDERS=heuristic,semantic,llm

# Optional: LLM providers (leave blank to keep router fully local + free)
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Optional: database connection for observability store (future)
DATABASE_URL=

# Path where mcp-nexus stores registry, policy, config
NEXUS_HOME=.nexus