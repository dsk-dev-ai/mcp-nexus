# ── MCP Nexus configuration ─────────────────────────────────────────────
# Copy to `.env` and edit. Values here are defaults; real process env vars
# and `.nexus/config.json` both override this file.

# Where registry.json / policy.json / activity.jsonl live.
# Defaults to ./nexus-data when unset (legacy: NEXUS_HOME still honored).
MCP_NEXUS_HOME=./nexus-data

# Dashboard / future HTTP endpoint port.
MCP_NEXUS_PORT=3000

# Bind address. 127.0.0.1 (default) keeps it local-only;
# 0.0.0.0 lets the container/VM port mapping reach it.
MCP_NEXUS_HOST=127.0.0.1

# Runtime log verbosity: debug | info | warn | error.
MCP_NEXUS_LOG_LEVEL=info

# Routing strategy:
#   hybrid    → heuristic → semantic → LLM (default; works without an LLM key)
#   heuristic → heuristic only
#   semantic  → heuristic → semantic
#   llm       → heuristic → semantic → LLM
MCP_NEXUS_ROUTER_MODE=hybrid

# Explicit provider order overrides ROUTER_MODE, e.g.
# MCP_NEXUS_ROUTER_PROVIDERS=heuristic,semantic

# Default tool execution timeout in milliseconds.
MCP_NEXUS_EXECUTION_TIMEOUT=30000

# Optional LLM routing providers (never committed to the repository).
# MCP_NEXUS_OPENROUTER_API_KEY=
# MCP_NEXUS_GEMINI_API_KEY=